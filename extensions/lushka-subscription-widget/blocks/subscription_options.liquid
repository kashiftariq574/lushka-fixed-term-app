{% if product != blank %}
  {% assign current_variant = product.selected_or_first_available_variant %}

  {% for candidate_allocation in current_variant.selling_plan_allocations %}
    {% assign candidate_plan = candidate_allocation.selling_plan %}

    {% if candidate_plan.name == 'Complete Haircare Recovery 90' or candidate_plan.name == 'Serum Ritual 90' %}
      {% assign allocation = candidate_allocation %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if allocation != blank %}
    {% assign plan = allocation.selling_plan %}

    <div
      id="lushka-subscription-{{ block.id }}"
      data-selling-plan-id="{{ plan.id }}"
      data-current-price="{{ current_variant.price | money | escape }}"
      data-current-price-currency="{{ current_variant.price | money_with_currency | escape }}"
      data-subscription-price="{{ allocation.price | money | escape }}"
      data-subscription-price-currency="{{ allocation.price | money_with_currency | escape }}"
      style="display:none !important;"
      {{ block.shopify_attributes }}
    ></div>

    <script>
      (() => {
        const root = document.getElementById(
          'lushka-subscription-{{ block.id }}'
        );

        if (!root) return;

        const sellingPlanId = root.dataset.sellingPlanId;
        const currentPrice = root.dataset.currentPrice;
        const currentPriceCurrency = root.dataset.currentPriceCurrency;
        const subscriptionPrice = root.dataset.subscriptionPrice;

        if (!sellingPlanId) return;

        function getSection() {
          return root.closest('.shopify-section') || document;
        }

        function getProductForm() {
          const section = getSection();

          return (
            section.querySelector('form[action*="/cart/add"]') ||
            document.querySelector('form[action*="/cart/add"]')
          );
        }

        function selectAndHideNativePurchaseOptions() {
          const section = getSection();
          const radios = section.querySelectorAll('input[type="radio"]');

          radios.forEach((radio) => {
            const wrapper =
              radio.closest('label') ||
              radio.closest('fieldset') ||
              radio.parentElement;

            const text = (wrapper?.textContent || '').toLowerCase();
            const value = String(radio.value || '');
            const radioPlanId =
              radio.dataset.sellingPlanId ||
              radio.dataset.sellingPlan ||
              '';

            const isSubscription =
              value === sellingPlanId ||
              radioPlanId === sellingPlanId ||
              (
                !text.includes('one-time purchase') &&
                !text.includes('one time purchase') &&
                (
                  text.includes('complete haircare recovery 90') ||
                  text.includes('serum ritual 90')
                )
              );

            const isOneTime =
              text.includes('one-time purchase') ||
              text.includes('one time purchase');

            if (isSubscription) {
              radio.disabled = false;

              if (!radio.checked) {
                radio.checked = true;
                radio.dispatchEvent(
                  new Event('input', { bubbles: true })
                );
                radio.dispatchEvent(
                  new Event('change', { bubbles: true })
                );
              }
            } else if (isOneTime) {
              radio.checked = false;
            }

            if (isSubscription || isOneTime) {
              if (wrapper) {
                wrapper.style.display = 'none';
              }
            }
          });
        }

        function updateDisplayedPrice() {
          const section = getSection();

          const selectors = [
            '.price-item--regular',
            '.price-item--sale',
            '.product__price',
            '.product-price',
            '[data-product-price]',
            '.price__regular',
            '.price'
          ];

          section.querySelectorAll(selectors.join(',')).forEach((el) => {
            const text = (el.textContent || '').trim();

            const matchesCurrentPrice =
              text === currentPrice ||
              text === currentPriceCurrency ||
              text.includes(currentPrice) ||
              text.includes(currentPriceCurrency);

            if (matchesCurrentPrice && subscriptionPrice) {
              el.textContent = subscriptionPrice;
            }
          });
        }

        function syncSellingPlan() {
          const form = getProductForm();

          if (!form) return;

          form
            .querySelectorAll(
              'input[name="selling_plan"]:not([data-lushka-generated])'
            )
            .forEach((input) => {
              input.disabled = true;
            });

          let sellingPlanInput = form.querySelector(
            'input[data-lushka-generated="true"]'
          );

          if (!sellingPlanInput) {
            sellingPlanInput = document.createElement('input');
            sellingPlanInput.type = 'hidden';
            sellingPlanInput.name = 'selling_plan';
            sellingPlanInput.dataset.lushkaGenerated = 'true';
            form.appendChild(sellingPlanInput);
          }

          sellingPlanInput.disabled = false;
          sellingPlanInput.value = sellingPlanId;

          selectAndHideNativePurchaseOptions();
          updateDisplayedPrice();
        }

        syncSellingPlan();

        setTimeout(syncSellingPlan, 250);
        setTimeout(syncSellingPlan, 750);
        setTimeout(syncSellingPlan, 1500);

        document.addEventListener(
          'shopify:section:load',
          syncSellingPlan
        );
      })();
    </script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "LUSHKA Subscription",
  "target": "section",
  "settings": []
}
{% endschema %}
