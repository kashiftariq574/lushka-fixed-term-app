{% if product != blank %}
  {% assign current_variant = product.selected_or_first_available_variant %}

  {% for candidate_allocation in current_variant.selling_plan_allocations %}
    {% assign candidate_plan = candidate_allocation.selling_plan %}

    {% if candidate_plan.name == 'Complete Haircare Recovery 90' or candidate_plan.name == 'Serum Ritual 90' %}
      {% assign allocation = candidate_allocation %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if allocation != blank %}
    {% assign plan = allocation.selling_plan %}
    {% assign adjustment = plan.price_adjustments | first %}

    <div
      id="lushka-subscription-{{ block.id }}"
      class="lushka-subscription-options"
      data-selling-plan-id="{{ plan.id }}"
      {{ block.shopify_attributes }}
    >
      <div class="lushka-subscription-heading">
        {{ block.settings.heading }}
      </div>

      <div class="lushka-programme-card">
        <div class="lushka-programme-title">
          {{ plan.name }}
        </div>

        <div class="lushka-programme-price">
          {{ allocation.price | money_with_currency }}
          <span class="lushka-programme-frequency">/ month</span>
        </div>

        {% if adjustment.value_type == 'percentage' %}
          <div class="lushka-programme-saving">
            Save {{ adjustment.value | round }}%
          </div>
        {% endif %}

        <div class="lushka-programme-description">
          3 monthly payments total
        </div>
      </div>

      <div class="lushka-fixed-term-note">
        Fixed 3-month programme. No further subscription payment after the third payment.
      </div>
    </div>

    <style>
      #lushka-subscription-{{ block.id }} {
        margin: 20px 0;
        font-family: inherit;
      }

      #lushka-subscription-{{ block.id }} .lushka-subscription-heading {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 10px;
      }

      #lushka-subscription-{{ block.id }} .lushka-programme-card {
        padding: 16px;
        border: 1px solid rgba(0, 0, 0, 0.18);
        border-radius: 8px;
      }

      #lushka-subscription-{{ block.id }} .lushka-programme-title {
        font-weight: 600;
        margin-bottom: 6px;
      }

      #lushka-subscription-{{ block.id }} .lushka-programme-price {
        font-size: 18px;
        font-weight: 600;
      }

      #lushka-subscription-{{ block.id }} .lushka-programme-frequency {
        font-size: 13px;
        font-weight: 400;
        opacity: 0.75;
      }

      #lushka-subscription-{{ block.id }} .lushka-programme-saving {
        margin-top: 5px;
        font-size: 14px;
        font-weight: 600;
      }

      #lushka-subscription-{{ block.id }} .lushka-programme-description,
      #lushka-subscription-{{ block.id }} .lushka-fixed-term-note {
        font-size: 13px;
        opacity: 0.75;
      }

      #lushka-subscription-{{ block.id }} .lushka-programme-description {
        margin-top: 5px;
      }

      #lushka-subscription-{{ block.id }} .lushka-fixed-term-note {
        margin-top: 8px;
      }
    </style>

    <script>
      (() => {
        const root = document.getElementById(
          'lushka-subscription-{{ block.id }}'
        );

        if (!root) return;

        const sellingPlanId = root.dataset.sellingPlanId;

        if (!sellingPlanId) return;

        function getProductForm() {
          const section = root.closest('.shopify-section');

          return (
            section?.querySelector('form[action*="/cart/add"]') ||
            document.querySelector('form[action*="/cart/add"]')
          );
        }

        function hideNativePurchaseOptions() {
          const form = getProductForm();

          if (!form) return;

          const radios = form.querySelectorAll('input[type="radio"]');

          radios.forEach((radio) => {
            const wrapper =
              radio.closest('label') ||
              radio.closest('fieldset') ||
              radio.parentElement;

            const text = (wrapper?.textContent || '').toLowerCase();

            if (
              text.includes('one-time purchase') ||
              text.includes('one time purchase') ||
              text.includes('complete haircare recovery 90') ||
              text.includes('serum ritual 90')
            ) {
              if (wrapper) {
                wrapper.style.display = 'none';
              }
            }
          });
        }

        function syncSellingPlan() {
          const form = getProductForm();

          if (!form) return;

          form
            .querySelectorAll(
              'input[name="selling_plan"]:not([data-lushka-generated])'
            )
            .forEach((input) => {
              input.disabled = true;
            });

          let sellingPlanInput = form.querySelector(
            'input[data-lushka-generated="true"]'
          );

          if (!sellingPlanInput) {
            sellingPlanInput = document.createElement('input');
            sellingPlanInput.type = 'hidden';
            sellingPlanInput.name = 'selling_plan';
            sellingPlanInput.dataset.lushkaGenerated = 'true';
            form.appendChild(sellingPlanInput);
          }

          sellingPlanInput.disabled = false;
          sellingPlanInput.value = sellingPlanId;

          hideNativePurchaseOptions();
        }

        syncSellingPlan();

        setTimeout(syncSellingPlan, 250);
        setTimeout(syncSellingPlan, 750);

        document.addEventListener('shopify:section:load', syncSellingPlan);
      })();
    </script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "LUSHKA Subscription",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your 3-month programme"
    }
  ]
}
{% endschema %}
