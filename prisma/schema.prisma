// Lushka Fixed-Term Subscriptions
// Shopify Session model + Lushka subscription data

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopConfig {
  id   String @id @default(cuid())
  shop String @unique

  completeParentProductId String?
  completeParentVariantId String?

  serumVariantId       String?
  shampooVariantId     String?
  conditionerVariantId String?
  maskVariantId        String?
  oilVariantId         String?
  massagerVariantId    String?

  locationId String?

  completeSellingPlanGroupId String?
  completeSellingPlanId      String?

  serumSellingPlanGroupId String?
  serumSellingPlanId      String?

  shippingMode String @default("SHOPIFY_CHECKOUT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContractState {
  id         String  @id @default(cuid())
  shop       String
  contractId String  @unique
  customerId String?

  planType String
  status   String @default("ACTIVE")

  successfulCycleCount Int     @default(0)
  lastSuccessfulCycle  Int?
  lastOrderId          String?

  startedAt     DateTime  @default(now())
  nextBillingAt DateTime?

  completedAt DateTime?
  failedAt    DateTime?

  // Set after all automatic renewal attempts fail.
  // Reserved programme stock remains protected until this deadline.
  paymentHoldStartedAt DateTime?
  paymentHoldUntil     DateTime?

  retryCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts     BillingAttempt[]
  reservations InventoryReservation[]

  @@index([shop])
  @@index([status])
  @@index([nextBillingAt])
  @@index([paymentHoldUntil])
}

model BillingAttempt {
  id String @id @default(cuid())

  contractStateId String
  contractId      String

  cycleIndex     Int
  idempotencyKey String @unique

  status       String @default("PENDING")
  attemptCount Int    @default(0)

  error String?

  shopifyBillingAttemptId String?
  shopifyOrderId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractState ContractState @relation(fields: [contractStateId], references: [id], onDelete: Cascade)

  @@unique([contractId, cycleIndex, attemptCount])
  @@index([contractId, cycleIndex])
  @@index([status])
}

model InventoryReservation {
  id String @id @default(cuid())

  shop       String
  contractId String
  planType   String

  variantId       String
  inventoryItemId String
  locationId      String

  // Future programme units placed aside for this contract.
  reservedQuantity Int

  // Increments whenever a rolled-back reservation is attempted again.
  // Used to generate a fresh Shopify idempotency key after rollback.
  reservationAttempt Int @default(1)

  // Increments when a renewal reservation release is rolled back,
  // so the next retry receives a fresh Shopify idempotency key.
  consumptionAttempt Int @default(1)

  // Units already used by successful future deliveries.
  consumedQuantity Int @default(0)

  // Units returned to sellable inventory after cancellation/hold expiry.
  releasedQuantity Int @default(0)

  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractState ContractState @relation(fields: [contractId], references: [contractId], onDelete: Cascade)

  @@unique([contractId, variantId])
  @@index([shop])
  @@index([contractId])
  @@index([status])
}

model InventoryProcess {
  id String @id @default(cuid())

  shop     String
  orderId  String
  planType String

  idempotencyKey String   @unique
  processedAt    DateTime @default(now())

  @@unique([shop, orderId, planType])
  @@index([shop])
}

model ContinuationEvent {
  id String @id @default(cuid())

  shop       String
  contractId String @unique

  dueAt  DateTime
  status String    @default("PENDING")
  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
  @@index([dueAt])
  @@index([status])
}

model EmailEvent {
  id String @id @default(cuid())

  shop           String
  contractId     String
  orderId        String?
  emailType      String
  recipientEmail String

  idempotencyKey String @unique

  status            String    @default("PENDING")
  attemptCount      Int       @default(0)
  providerMessageId String?
  error             String?
  dueAt             DateTime?
  sentAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, emailType])
  @@index([shop])
  @@index([status])
  @@index([dueAt])
}

model ReviewSignalEvent {
  id String @id @default(cuid())

  shop       String
  orderId    String
  signalType String
  readyTag   String

  // Unique logical action. Duplicate Shopify webhooks for the same
  // order/signal must resolve to this same record.
  signalKey String @unique

  // Present only for Shopify Forms reward signals.
  metaobjectHandle String?

  /**
   * Lifecycle examples:
   * PENDING
   * PROCESSING
   * COMPLETED
   * REJECTED
   * RETRYABLE
   */
  status String @default("PENDING")

  attemptCount Int @default(0)

  // Used as a processing lease so a crashed PROCESSING job can
  // safely become eligible for retry after a timeout.
  processingStartedAt DateTime?

  // Reward signals may create a deterministic discount before email.
  // Persist it so retries do not create a second discount.
  discountCode String?

  // Only one valid reward may be granted for an order/reward stage.
  // Nullable so request signals and unvalidated form signals do not
  // participate in the uniqueness constraint.
  rewardKey String? @unique

  // Resend provider message id after successful delivery.
  providerMessageId String?

  lastError String?

  emailSentAt DateTime?
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, orderId])
  @@index([shop, status])
  @@index([status])
  @@index([processingStartedAt])
}
